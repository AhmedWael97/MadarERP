    "frappe-react-sdk": "^1.15.0",
    "i18next": "^23.15.2",
    "i18next-http-backend": "^2.6.2",
    "lucide-react": "^0.452.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^15.0.3",
