# --- Frappe / ERPNext ---
ERPNEXT_BASE_IMAGE=frappe/erpnext:v15
DB_ROOT_PASSWORD=admin
ADMIN_PASSWORD=admin

# Sites created on first boot (space-separated; first one becomes the default).
# Each gets erpnext + madaar_core installed. Start with one for faster first boot;
# add `t1.localhost admin.localhost` once you've verified the stack works.
SITES=dev.localhost

# --- Frontend (Vite) ---
# Public root domain used for tenant detection in the React app.
# In dev we use .localhost so browsers send the subdomain to the proxy.
VITE_ROOT_DOMAIN=localhost
# Optional: pin a tenant when running the SPA on bare http://localhost:5173
VITE_TENANT_OVERRIDE=dev

# --- Ports exposed on the host ---
FRAPPE_HTTP_PORT=8000
FRAPPE_SOCKET_PORT=9000
FRONTEND_PORT=5173
